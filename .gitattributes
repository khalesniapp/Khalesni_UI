# Normalise line endings so a Windows and a macOS/Linux checkout do not show
# every file as modified. Text is stored LF in the repo and checked out with
# each machine's native endings.
* text=auto

# Fonts and images are binary — never touch their bytes.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.webp  binary

# Generated; collapse it in diffs and reviews.
package-lock.json -diff linguist-generated
